# Both are public (they ship in the bundle). Copy to .env.local.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional: override the API base (default: $VITE_SUPABASE_URL/functions/v1/sawk)
# VITE_SAWK_API=
# Optional: show "Continue with Google / Apple" (needs this origin in the project's redirect allow-list)
# VITE_SAWK_OAUTH=1
# Dev only: serve clearly labelled sample data, no network. Ignored by production builds.
# VITE_SAWK_MOCK=1
