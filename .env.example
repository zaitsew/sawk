# Copy to .env. Names only; ./check.sh reports the ones still unset.
#
# The Supabase project SAWk lives in: https://<ref>.supabase.co
SUPABASE_URL=
# How `deno task migrate` reaches the database — one of:
#   DATABASE_URL          direct Postgres connection string (Settings → Database)
#   SUPABASE_PROJECT_REF  the project ref; uses SUPABASE_ACCESS_TOKEN or the `supabase login` token
# DATABASE_URL=
SUPABASE_PROJECT_REF=
# Optional: a free Ticketmaster Discovery key (developer.ticketmaster.com). Without it, that source is skipped.
# TICKETMASTER_API_KEY=
# Project ref for `./check.sh usage` (teyla probe-sql). Kept out of teyla.toml because this repo is public.
# SAWK_PROBE_REF=
